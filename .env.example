# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite:///./clinic.db

# --- Meta WhatsApp Business Platform (Cloud API) ------------------------
# Temporary/permanent access token from the Meta developer dashboard
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" of your (test) WhatsApp number - NOT the phone number itself
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; you paste the same value into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings > Basic). Used to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=

# Optional -------------------------------------------------------------
# Graph API version used for outgoing messages
WHATSAPP_API_VERSION=v23.0
# LOCAL TESTING ONLY: accept webhook POSTs without a valid signature when
# WHATSAPP_APP_SECRET is empty. Leave false whenever the app is reachable from the internet.
WHATSAPP_ALLOW_UNSIGNED=false

# --- Clinic behaviour ----------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata
# Prefix applied to 10-digit phone numbers typed into the REST API (not to WhatsApp numbers)
DEFAULT_COUNTRY_CODE=91
# Spacing between bookable start times
SLOT_INTERVAL_MINUTES=30
# How far ahead patients can book
BOOKING_WINDOW_DAYS=60
# Idle time after which a WhatsApp conversation resets to the main menu
SESSION_TIMEOUT_MINUTES=30
